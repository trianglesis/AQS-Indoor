menu "AQS Temperature, humidity sensor"
        
    config BME680_I2C_ADDR_0
        hex "I2C BME680 ADDRESS"
        default 0x76
        help
            Address of I2C BME680 sensor
    
    config BME680_I2C_ADDR_1
        hex "I2C BME680 ADDRESS"
        default 0x77
        help
            Address of I2C BME680 sensor

    config BME680_MEASUREMENT_FREQ_SECONDS
        int "Measure request frequency in SECONDS"
        default 5
        help
            How long should we wait before getting next measurement. Default 5 sec, cannot be less!

endmenu
